# Normalize line endings across platforms: store text files as LF in the repo
# and check them out as LF (matches the Ubuntu CI runners and Linux containers).
* text=auto eol=lf

# Shell scripts must always be LF.
*.sh text eol=lf

# Windows scripts stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never apply line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
