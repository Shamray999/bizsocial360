# ---- Runtime ----
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed origins for the web client.
CORS_ORIGIN=http://localhost:3000

# ---- Database (Azure Database for PostgreSQL Flexible Server) ----
# Azure requires SSL. Keep sslmode=require for managed instances.
# Local dev (docker-compose) example:
#   postgresql://bizsocial:bizsocial@localhost:5432/bizsocial360?schema=public
# Azure example:
#   postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/bizsocial360?sslmode=require
DATABASE_URL=postgresql://bizsocial:bizsocial@localhost:5432/bizsocial360?schema=public

# ---- Provider OAuth (connecting social accounts) ----
# Public base URL of THIS api. Used to build the OAuth redirect URIs below;
# it must match the redirect URIs registered in each provider's app settings.
APP_BASE_URL=http://localhost:4000

# Encryption key for provider tokens at rest (AES-256-GCM). Required before any
# account can be connected. Generate one with:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Optional: dedicated HMAC secret for signing the OAuth state (CSRF).
# Falls back to TOKEN_ENCRYPTION_KEY when left blank.
OAUTH_STATE_SECRET=

# ---- App authentication (user sign-in) ----
# Secret used to sign session JWTs. Required to issue/verify logins.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=
# Session token lifetime (e.g. 15m, 12h, 7d).
JWT_EXPIRES_IN=7d

# Meta app (one app serves Facebook + Instagram). From developers.facebook.com.
# Register redirect URIs:
#   http://localhost:4000/connect/facebook/callback
#   http://localhost:4000/connect/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# TikTok app. From developers.tiktok.com. Also requires ENABLE_TIKTOK=true.
# Register redirect URI: http://localhost:4000/connect/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Feature flags ----
# TikTok integration is scaffolded but gated until API access is approved.
ENABLE_TIKTOK=false
